# MQTT
MQTT_ENABLED=true

MQTT_BROKER=192.168.1.170
MQTT_PORT=1883

# MQTT events
MQTT_TOPIC=ups/deb2bot/event

# MQTT retained UPS state
MQTT_STATE_TOPIC=ups/deb2bot/state

# MQTT exporter availability
MQTT_AVAILABILITY_TOPIC=ups/deb2bot/availability

# UPS polling
POLL_INTERVAL_SEC=300
APCACCESS_TIMEOUT_SEC=10

# HTTP
HTTP_PORT=8011

# Logging
LOG_FILE=/opt/ups-mqtt/ups_exporter.log
LOG_LEVEL=INFO
